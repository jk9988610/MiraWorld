{
  "name": "miraworld",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "auth:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-api.ps1",
    "deploy": "python -u deploy/deploy.py",
    "deploy:api": "python -u deploy/sync_api.py",
    "backup:db": "python -u deploy/backup_db.py",
    "backup:db:cron": "python -u deploy/backup_db.py --install-cron",
    "smoke:demo": "python -u deploy/smoke_demo.py",
    "smoke:shop": "python -u deploy/smoke_demo.py --v12",
    "smoke:auto": "python -u deploy/smoke_demo.py --v14",
    "smoke:bounty": "python -u deploy/smoke_demo.py --v15",
    "smoke:economy": "python -u deploy/smoke_demo.py --v20",
    "smoke:capital": "python -u deploy/smoke_demo.py --v21",
    "smoke:hub": "python -u deploy/smoke_demo.py --v22",
    "smoke:production": "python -u deploy/smoke_demo.py --v22-prod",
    "smoke:gate": "python -u deploy/smoke_demo.py --v24-gate",
    "smoke:solo": "python -u deploy/smoke_demo.py --v24-solo -n 1",
    "smoke:solo:local": "python -u deploy/smoke_demo.py --v24-solo -n 1 --base http://127.0.0.1:8787",
    "economy:cron": "python -u deploy/economy_tick_cron.py --install-cron",
    "purge:test-accounts": "python -u deploy/purge_test_accounts.py"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
