{
  "name": "miraworld",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "auth:dev": "cd server && MIRAWORLD_DB=../data/miraworld.db MIRAWORLD_JWT_SECRET=dev-secret-change-me python3 -m uvicorn app:app --reload --port 8787",
    "deploy": "python3 -u deploy/deploy.py",
    "deploy:api": "python3 -u deploy/sync_api.py"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
